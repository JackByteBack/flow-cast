# Database
DATABASE_URL=postgresql+asyncpg://flowcast:flowcast@localhost:5432/flowcast
DATABASE_URL_SYNC=postgresql://flowcast:flowcast@localhost:5432/flowcast

# JWT
JWT_SECRET=change-me-in-production-use-a-real-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]

# OSRM
OSRM_BASE_URL=http://localhost:5000

# App
APP_NAME=FlowCast + BarrierLens
APP_VERSION=0.1.0
DEBUG=true
