# ── Public hostname of this server ───────────────────────────────────────────
# Create a DNS "A" record (e.g. api.yourdomain.com) pointing at the VPS IP.
# No domain yet? Use "<VPS-IP>.nip.io" (e.g. 203.0.113.10.nip.io) — it resolves
# to your IP automatically and still gets a valid HTTPS certificate.
BACKEND_DOMAIN=api.yourdomain.com

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=flowcast
POSTGRES_PASSWORD=CHANGE-ME-USE-A-LONG-RANDOM-STRING
POSTGRES_DB=flowcast

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a real one with:  openssl rand -hex 32
JWT_SECRET=CHANGE-ME-RUN-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────────
# The Vercel frontend is proxied (same-origin), so this is a safety net only.
CORS_ORIGINS=["https://flow-cast-ashen.vercel.app"]

# ── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=FlowCast + BarrierLens
APP_VERSION=0.1.0
DEBUG=false
