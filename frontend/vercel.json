{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://api.YOUR-DOMAIN.example/api/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "https://api.YOUR-DOMAIN.example/uploads/:match*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
